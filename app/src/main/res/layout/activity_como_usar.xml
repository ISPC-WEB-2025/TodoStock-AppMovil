<?xml version="1.0" encoding="utf-8"?>
<!-- Cómo usar TodoStock (vertical). En horizontal se usa layout-land. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarComoUsar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_botones"
        app:navigationContentDescription="@string/ayuda_volver"
        app:navigationIcon="@drawable/flecha_atras"
        app:title="@string/como_usar_titulo"
        app:titleCentered="true"
        app:titleTextColor="@color/color_fondo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margen_horizontal_pantalla"
            android:paddingBottom="32dp">

            <!-- Caja del video: tiene el ancho justo del video y va centrada, sin barras negras.
                 Los controles se muestran dentro y miden lo mismo que el video. -->
            <FrameLayout
                android:id="@+id/contenedorVideo"
                android:layout_width="wrap_content"
                android:layout_height="380dp"
                android:layout_gravity="center_horizontal">

                <VideoView
                    android:id="@+id/videoComoUsar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:contentDescription="@string/como_usar_video_descripcion" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/como_usar_subtitulo"
                android:textColor="@color/color_texto"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/como_usar_texto"
                android:textColor="@color/color_texto"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>