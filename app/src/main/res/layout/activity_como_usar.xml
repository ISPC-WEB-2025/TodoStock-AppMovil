<?xml version="1.0" encoding="utf-8"?>
<!-- Cómo usar TodoStock (vertical). En horizontal se usa layout-land. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarComoUsar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_botones"
        app:navigationContentDescription="@string/ayuda_volver"
        app:navigationIcon="@drawable/flecha_atras"
        app:title="@string/como_usar_titulo"
        app:titleCentered="true"
        app:titleTextColor="@color/color_fondo" />

    <!-- El video ocupa todo el espacio libre. El VideoView se achica solo para
         mantener la proporción del video y queda centrado, sin barras negras. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/margen_horizontal_pantalla"
        android:paddingTop="16dp">

        <VideoView
            android:id="@+id/videoComoUsar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@string/como_usar_video_descripcion" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margen_horizontal_pantalla"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:text="@string/como_usar_texto"
        android:textColor="@color/color_texto"
        android:textSize="14sp" />

</LinearLayout>
