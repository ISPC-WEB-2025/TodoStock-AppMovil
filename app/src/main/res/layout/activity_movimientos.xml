<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- TÍTULO CENTRADO NUEVO -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MOVIMIENTOS > SUCURSALES"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <!-- Selector Sucursal Origen -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sucursal Origen:"
        android:textStyle="bold" />
    <Spinner
        android:id="@+id/spinnerOrigen"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp" />

    <!-- Selector Sucursal Destino -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sucursal Destino:"
        android:textStyle="bold" />
    <Spinner
        android:id="@+id/spinnerDestino"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp" />

    <!-- Selector Producto -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Producto:"
        android:textStyle="bold" />
    <Spinner
        android:id="@+id/spinnerProducto"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp" />

    <!-- Campo Cantidad -->
    <EditText
        android:id="@+id/etCantidad"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Cantidad a mover"
        android:inputType="number"
        android:layout_marginBottom="32dp" />

    <!-- BOTÓN MODIFICADO (Bordes redondeados) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirmar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Confirmar Movimiento"
        android:textColor="@color/white"
        android:background="@drawable/boton_redondeado" />

</LinearLayout>