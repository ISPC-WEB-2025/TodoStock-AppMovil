<?xml version="1.0" encoding="utf-8"?>
<!--
    TK109 / TK37: Pantalla unificada de Gestión de Usuarios.
    Alberga en 3 pestañas:
      1. Catálogo de usuarios (TK37 - Pedro Gonzalez)
      2. Cargar usuario nuevo (TK109 - Miguel Flores)
      3. Solicitudes pendientes de aprobación (TK109 - Miguel Flores)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:orientation="vertical">

    <!-- Toolbar unificada institucional (TK79) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarUsuarios"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_botones"
        app:navigationIcon="@drawable/flecha_atras"
        app:title="@string/usuarios_titulo"
        app:titleCentered="true"
        app:titleTextColor="@color/color_fondo" />

    <!-- Datos de sesion / Rol activo -->
    <TextView
        android:id="@+id/tvRolActivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:paddingVertical="12dp"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp" />

    <!-- Barra de pestañas -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutUsuarios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gris_fondo_input"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/color_botones"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/color_botones"
        app:tabTextColor="@color/texto_tenue" />

    <!-- Contenedor deslizable de pestañas -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerUsuarios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
