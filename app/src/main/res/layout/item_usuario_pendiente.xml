<?xml version="1.0" encoding="utf-8"?>
<!-- TK109: Tarjeta de solicitud de usuario pendiente -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/gris_fondo_input"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/gris_borde_input"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombrePendiente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre y Apellido"
                    android:textColor="@color/color_texto"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmailPendiente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="usuario@correo.com"
                    android:textColor="@color/texto_tenue"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDniPendiente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="DNI: 12345678"
                    android:textColor="@color/color_etiqueta"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Indicador de estado -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/input_fondo"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Pendiente"
                android:textColor="@color/color_detalles"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Botones de acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRechazar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:text="@string/usuarios_btn_rechazar"
                android:textColor="@color/color_errores"
                app:cornerRadius="20dp"
                app:strokeColor="@color/color_errores" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAprobar"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/usuarios_btn_aprobar"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:backgroundTint="@color/boton_presionado"
                app:cornerRadius="20dp" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
