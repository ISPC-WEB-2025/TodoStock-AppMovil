<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla intermedia (Hub) de Movimientos de Stock -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_fondo">

    <!-- Barra superior unificada -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMovimientos"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_botones"
        app:navigationIcon="@drawable/flecha_atras"
        app:title="@string/menu_mov_titulo"
        app:titleCentered="true"
        app:titleTextColor="@color/color_fondo" />

    <!-- Datos de sesion / Rol activo -->
    <TextView
        android:id="@+id/tvRolActivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="@dimen/margen_horizontal_pantalla"
        android:paddingVertical="16dp"
        android:text="Sesión activa: Administrador"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp" />

    <!-- Opciones de movimientos -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/margen_horizontal_pantalla"
            android:paddingVertical="16dp">

            <!-- Ingreso de mercadería (Entradas de stock) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMovIngresos"
                style="@style/BotonMenu"
                android:layout_marginBottom="16dp"
                android:text="@string/menu_mov_btn_ingresos" />

            <!-- Movimientos entre sucursales (Traslados) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMovSucursales"
                style="@style/BotonMenu"
                android:layout_marginBottom="16dp"
                android:text="@string/menu_mov_btn_sucursales" />

            <!-- Salida por venta (Salidas comerciales) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMovVentas"
                style="@style/BotonMenu"
                android:layout_marginBottom="16dp"
                android:text="@string/menu_mov_btn_ventas" />

            <!-- Baja de productos (Merma / Rotura / Descarte) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMovBajas"
                style="@style/BotonMenu"
                android:layout_marginBottom="16dp"
                android:text="@string/menu_mov_btn_bajas" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
