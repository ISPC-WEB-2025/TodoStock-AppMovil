<?xml version="1.0" encoding="utf-8"?>
<!--
    TK02: Layout del Menu Principal (Hub central)
    Responsable: Miguel Flores
    Accesos a las 5 pantallas hijas con diseno limpio y organizado
    TK79: barra superior unificada, botones sin borde (estilo BotonMenu), margen lateral
    de 32dp y "Cerrar Sesión" con la forma de los demás botones, en verde oscuro.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_fondo">

    <!-- Barra superior / Header -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMenu"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_botones"
        app:title="TodoStock - Menú"
        app:titleCentered="true"
        app:titleTextColor="@color/color_fondo" />

    <!-- Datos de sesion / Rol activo -->
    <TextView
        android:id="@+id/tvRolActivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:paddingVertical="16dp"
        android:text="Sesión activa: Administrador"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingVertical="8dp">

            <!-- Acceso 0: Gestión de Usuarios — solo Administrador (TK48).
                 Oculto en el código hasta que TK37 implemente la pantalla completa. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavUsuarios"
                style="@style/BotonMenu"
                android:text="@string/menu_btn_usuarios"
                android:visibility="gone" />

            <!-- Acceso 1: Seleccion de Sucursal -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavSucursal"
                style="@style/BotonMenu"
                android:text="1. Seleccionar Sucursal" />

            <!-- Acceso 2: Gestion de Stock -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavStock"
                style="@style/BotonMenu"
                android:text="2. Gestión de Stock" />

            <!-- Acceso 3: Carga de Producto -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavCargaProducto"
                style="@style/BotonMenu"
                android:text="3. Cargar Nuevo Producto" />

            <!-- Acceso 4: Movimientos entre Sucursales -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavMovimientos"
                style="@style/BotonMenu"
                android:text="4. Movimientos entre Sucursales" />

            <!-- Acceso 5: Contacto Soporte -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavContacto"
                style="@style/BotonMenu"
                android:text="5. Contacto / Soporte" />

            <!-- Acceso 6: Mi Perfil -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavPerfil"
                style="@style/BotonMenu"
                android:layout_marginBottom="24dp"
                android:text="6. Mi Perfil" />

            <!-- Boton Cerrar Sesion.
                 TK79: misma forma, alto y texto que los botones verdes de la app
                 (boton_redondeado: radio 25dp, 50dp de alto), en el verde oscuro de la app.
                 Texto claro: contraste 9.36. Antes: texto violeta sobre rojo (1.76).
                 Sigue siendo MaterialButton porque así lo usa MenuPrincipalActivity. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Cerrar Sesión"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/boton_presionado"
                app:cornerRadius="25dp" />

        </LinearLayout>
    </ScrollView>

    <!-- TK52: Darme de baja (derecho de arrepentimiento). Lo ven los dos roles.
         Fuera del ScrollView: queda siempre abajo de todo, más chico que las opciones. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDarmeDeBaja"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"
        android:text="@string/baja_boton"
        android:textAllCaps="false"
        android:textColor="@color/color_errores"
        android:textSize="14sp" />

</LinearLayout>
