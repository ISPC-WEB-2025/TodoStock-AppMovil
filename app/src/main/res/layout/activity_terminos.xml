<?xml version="1.0" encoding="utf-8"?>
<!-- TK52: Términos y condiciones y política de privacidad (textos de la TK105) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:orientation="vertical">

    <!-- TK79: barra superior unificada (MaterialToolbar con el título centrado) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarTerminos"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_botones"
        app:navigationContentDescription="@string/terminos_volver"
        app:navigationIcon="@drawable/flecha_atras"
        app:title="@string/terminos_titulo_pantalla"
        app:titleCentered="true"
        app:titleTextColor="@color/color_fondo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingVertical="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:accessibilityHeading="true"
                android:text="@string/titulo_terminos_y_condiciones"
                android:textColor="@color/color_texto"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTextoTerminos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/color_texto"
                android:textIsSelectable="true"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:accessibilityHeading="true"
                android:text="@string/titulo_politica_privacidad"
                android:textColor="@color/color_texto"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTextoPolitica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/color_texto"
                android:textIsSelectable="true"
                android:textSize="15sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
