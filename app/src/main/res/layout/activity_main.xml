<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/white">

    <!-- Mensaje dinámico de bienvenida -->
    <TextView
        android:id="@+id/tvBienvenida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Bienvenido/a!"
        android:textColor="@color/texto_principal"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Menú Principal"
        android:textColor="@color/texto_principal"
        android:textSize="16sp"
        android:layout_marginBottom="32dp" />

    <!-- Botón 1: Catálogo / Productos -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCatalogo"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Catálogo de Productos"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/boton_redondeado"
        android:layout_marginBottom="16dp" />

    <!-- Botón 2: Clientes / Usuarios -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnClientes"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Gestión de Clientes"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/boton_redondeado"
        android:layout_marginBottom="16dp" />

    <!-- Botón 3: Contacto (requerido por enunciado de Sprint 1) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContacto"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Contacto"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/boton_redondeado"
        android:layout_marginBottom="16dp" />

    <!-- Botón 4: Cerrar Sesión -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Cerrar Sesión"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/boton_redondeado" />

</LinearLayout>