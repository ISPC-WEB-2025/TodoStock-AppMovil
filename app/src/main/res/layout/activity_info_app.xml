<?xml version="1.0" encoding="utf-8"?>
<!-- Información de la app (logo, nombre, versión, slogan y pie). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarInfoApp"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_botones"
        app:navigationContentDescription="@string/ayuda_volver"
        app:navigationIcon="@drawable/flecha_atras"
        app:title="@string/info_app_titulo"
        app:titleCentered="true"
        app:titleTextColor="@color/color_fondo" />

    <!-- Contenido centrado en vertical; el ScrollView permite recorrerlo al rotar -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margen_horizontal_pantalla"
            android:paddingVertical="24dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@string/info_app_logo_descripcion"
                android:src="@drawable/todo_stock_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/info_app_nombre"
                android:textColor="@color/color_texto"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVersionApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/texto_tenue"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/info_app_slogan"
                android:textColor="@color/color_botones"
                android:textSize="18sp"
                android:textStyle="italic" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/info_app_pie"
                android:textColor="@color/texto_tenue"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>