<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Deshabilita el tráfico en texto plano (HTTP) en toda la app. Toda comunicación va por HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
