<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="EtiquetaPerfil">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <!-- TK79: color_etiqueta (contraste 7.25). color_detalles daba 4.13. -->
        <item name="android:textColor">@color/color_etiqueta</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ValorPerfil">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:textColor">@color/color_texto</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
