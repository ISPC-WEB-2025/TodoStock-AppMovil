<?xml version="1.0" encoding="utf-8"?>
<!-- TK40: Cómo usar TodoStock (horizontal): video a la izquierda, texto a la derecha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarComoUsar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_botones"
        app:navigationContentDescription="@string/ayuda_volver"
        app:navigationIcon="@drawable/flecha_atras"
        app:title="@string/como_usar_titulo"
        app:titleCentered="true"
        app:titleTextColor="@color/color_fondo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Caja del video: ancho justo del video, sin barras negras -->
        <FrameLayout
            android:id="@+id/contenedorVideo"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <VideoView
                android:id="@+id/videoComoUsar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@string/como_usar_video_descripcion" />
        </FrameLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/como_usar_subtitulo"
                    android:textColor="@color/color_texto"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/como_usar_texto"
                    android:textColor="@color/color_texto"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</LinearLayout>